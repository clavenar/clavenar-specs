{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clavenar.com/contracts/cluster-install-v1.schema.json",
  "title": "Clavenar existing-cluster install contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "release",
    "scope",
    "bootstrap",
    "installer",
    "uninstallBootstrap",
    "uninstaller",
    "clusterAccess",
    "helmInstall",
    "consoleAccess",
    "profiles",
    "lifecycle",
    "outOfScope"
  ],
  "properties": {
    "contract": {"const": "clavenar.cluster-install/v1"},
    "schemaVersion": {"const": 1},
    "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "scope": {"const": "existing-kubernetes-cluster"},
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "shell", "command"],
      "properties": {
        "url": {"const": "https://clavenar.ai/install.sh"},
        "shell": {"const": "sh"},
        "command": {"const": "curl -fsSL https://clavenar.ai/install.sh | sh"}
      }
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "checksumUrl", "mirrorUrls", "checksumMirrorUrls", "sha256", "shell"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "url": {"type": "string", "pattern": "^https://clavenar\\.ai/installers/clavenar-install-[0-9]+\\.[0-9]+\\.[0-9]+\\.sh$"},
        "checksumUrl": {"type": "string", "pattern": "^https://clavenar\\.ai/installers/clavenar-install-[0-9]+\\.[0-9]+\\.[0-9]+\\.sh\\.sha256$"},
        "mirrorUrls": {
          "const": ["https://dev.clavenar.ai/installers/clavenar-install-1.4.4.sh"]
        },
        "checksumMirrorUrls": {
          "const": ["https://dev.clavenar.ai/installers/clavenar-install-1.4.4.sh.sha256"]
        },
        "sha256": {"type": "string", "pattern": "^sha256:(?!0{64})[0-9a-f]{64}$"},
        "shell": {"const": "bash"}
      }
    },
    "uninstallBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "shell", "command"],
      "properties": {
        "url": {"const": "https://clavenar.ai/uninstall.sh"},
        "shell": {"const": "sh"},
        "command": {"const": "curl -fsSL https://clavenar.ai/uninstall.sh | sh"}
      }
    },
    "uninstaller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "checksumUrl", "mirrorUrls", "checksumMirrorUrls", "sha256", "shell"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "url": {"type": "string", "pattern": "^https://clavenar\\.ai/installers/clavenar-uninstall-[0-9]+\\.[0-9]+\\.[0-9]+\\.sh$"},
        "checksumUrl": {"type": "string", "pattern": "^https://clavenar\\.ai/installers/clavenar-uninstall-[0-9]+\\.[0-9]+\\.[0-9]+\\.sh\\.sha256$"},
        "mirrorUrls": {
          "const": ["https://dev.clavenar.ai/installers/clavenar-uninstall-1.1.3.sh"]
        },
        "checksumMirrorUrls": {
          "const": ["https://dev.clavenar.ai/installers/clavenar-uninstall-1.1.3.sh.sha256"]
        },
        "sha256": {"type": "string", "pattern": "^sha256:(?!0{64})[0-9a-f]{64}$"},
        "shell": {"const": "bash"}
      }
    },
    "clusterAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clients",
        "contextPolicy",
        "minimumKubernetesMinor",
        "maximumKubernetesMinor",
        "preflight"
      ],
      "properties": {
        "clients": {
          "const": ["kubectl", "k3s-kubectl"]
        },
        "contextPolicy": {"const": "explicit-or-confirmed-current-context"},
        "minimumKubernetesMinor": {"const": 30},
        "maximumKubernetesMinor": {"const": 36},
        "preflight": {
          "const": [
            "api-reachable",
            "context-confirmed",
            "version-supported",
            "nodes-ready",
            "default-storage-class",
            "permissions-complete",
            "release-collision-checked",
            "console-authentication-selected",
            "render-valid",
            "exact-digest-images"
          ]
        }
      }
    },
    "helmInstall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version",
        "registry",
        "releaseUrl",
        "checksumAsset",
        "valuesAsset",
        "valuesSha256",
        "packagedValues",
        "defaultNamespace",
        "defaultRelease",
        "timeout",
        "wait",
        "waitForJobs"
      ],
      "properties": {
        "repository": {"const": "clavenar-charts"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "registry": {"const": "oci://ghcr.io/clavenar/charts/clavenar"},
        "releaseUrl": {"type": "string", "pattern": "^https://github\\.com/clavenar/clavenar-charts/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "checksumAsset": {"type": "string", "pattern": "^clavenar-[0-9]+\\.[0-9]+\\.[0-9]+\\.tgz\\.sha256$"},
        "valuesAsset": {"type": "string", "pattern": "^clavenar-images-[0-9]+\\.[0-9]+\\.[0-9]+\\.yaml$"},
        "valuesSha256": {"type": "string", "pattern": "^sha256:(?!0{64})[0-9a-f]{64}$"},
        "packagedValues": {"const": "examples/values-bundled.yaml"},
        "defaultNamespace": {"const": "clavenar"},
        "defaultRelease": {"const": "clavenar"},
        "timeout": {"const": "10m"},
        "wait": {"const": true},
        "waitForJobs": {"const": true}
      }
    },
    "consoleAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultMode",
        "authSelectionFlag",
        "authSelections",
        "anonymousDemoDefault",
        "demoOptInProfile",
        "bootstrapPolicy",
        "bootstrapSecretNameTemplate",
        "bootstrapSecretKey",
        "bootstrapUrlTemplate",
        "bootstrapTokenTransport",
        "bootstrapRole",
        "bootstrapTokenInReceipt",
        "mtlsMode",
        "operatorTrustSecretNameTemplate",
        "operatorTrustSecretKeys",
        "operatorTrustInputFlags",
        "mtlsMissingTrustPolicy",
        "operatorBootstrapDirectoryFlag",
        "localBootstrapDefaultRoot",
        "localBootstrapRole",
        "localBootstrapPrivateKeyProjection",
        "browserCredentialFormat",
        "requiredOperatorRole",
        "mutationOriginsDefault"
      ],
      "properties": {
        "defaultMode": {"const": "webauthn"},
        "authSelectionFlag": {"const": "--console-auth"},
        "authSelections": {"const": ["passkey", "mtls"]},
        "anonymousDemoDefault": {"const": false},
        "demoOptInProfile": {"const": "evaluation"},
        "bootstrapPolicy": {"const": "one-time-admin-passkey"},
        "bootstrapSecretNameTemplate": {"const": "{release}-shared-tokens"},
        "bootstrapSecretKey": {"const": "hil-bootstrap-token"},
        "bootstrapUrlTemplate": {"const": "http://localhost:8085/register#bootstrap={token}"},
        "bootstrapTokenTransport": {"const": "url-fragment"},
        "bootstrapRole": {"const": "admin"},
        "bootstrapTokenInReceipt": {"const": false},
        "mtlsMode": {"const": "operator-mtls"},
        "operatorTrustSecretNameTemplate": {"const": "{release}-operator-public-trust"},
        "operatorTrustSecretKeys": {"const": ["ca.crt", "operators.json"]},
        "operatorTrustInputFlags": {"const": ["--operator-ca", "--operator-registry"]},
        "mtlsMissingTrustPolicy": {"const": "local-admin-bootstrap"},
        "operatorBootstrapDirectoryFlag": {"const": "--operator-bootstrap-dir"},
        "localBootstrapDefaultRoot": {"const": "$HOME/.clavenar/operator-bootstrap"},
        "localBootstrapRole": {"const": "admin"},
        "localBootstrapPrivateKeyProjection": {"const": false},
        "browserCredentialFormat": {"const": "PKCS#12"},
        "requiredOperatorRole": {"const": "admin"},
        "mutationOriginsDefault": {"const": ["http://localhost:8085"]}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/profile"},
            {
              "properties": {
                "name": {"const": "operator"},
                "default": {"const": true},
                "values": {"const": "examples/values-bundled.yaml+installer-operator-overlay"},
                "verification": {
                  "const": [
                    "workloads-ready",
                    "exact-digest-images",
                    "passkey-admin-bootstrap-ready",
                    "anonymous-demo-disabled",
                    "tools-list",
                    "ledger-chain-advanced"
                  ]
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/profile"},
            {
              "properties": {
                "name": {"const": "evaluation"},
                "default": {"const": false},
                "values": {"const": "examples/values-bundled.yaml"},
                "verification": {
                  "const": [
                    "workloads-ready",
                    "exact-digest-images",
                    "tools-list",
                    "ledger-chain-advanced"
                  ]
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/profile"},
            {
              "properties": {
                "name": {"const": "custom"},
                "default": {"const": false},
                "values": {"const": "operator-supplied"},
                "verification": {
                  "const": [
                    "workloads-ready",
                    "exact-digest-images",
                    "anonymous-demo-disabled"
                  ]
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "states",
        "collisionPolicy",
        "failurePolicy",
        "adoptionPolicy",
        "receipt",
        "uninstall"
      ],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["absent", "current", "upgrade", "failed", "foreign"]}
        },
        "collisionPolicy": {"const": "fail-closed"},
        "failurePolicy": {"const": "preserve-release-and-state"},
        "adoptionPolicy": {"const": "explicit-exact-release-only"},
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nameTemplate", "containsSecrets"],
          "properties": {
            "kind": {"const": "ConfigMap"},
            "nameTemplate": {"const": "{release}-cluster-install-receipt"},
            "containsSecrets": {"const": false}
          }
        },
        "uninstall": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "defaultDataDisposition",
            "namespaceDisposition",
            "ownershipPolicy",
            "destructiveDataFlag",
            "destructiveConfirmationFlag",
            "checkFlag",
            "retainedResources",
            "removedResources"
          ],
          "properties": {
            "defaultDataDisposition": {"const": "retain"},
            "namespaceDisposition": {"const": "retain"},
            "ownershipPolicy": {"const": "exact-release-or-explicit-adoption"},
            "destructiveDataFlag": {"const": "--delete-data"},
            "destructiveConfirmationFlag": {"const": "--confirm-data-deletion"},
            "checkFlag": {"const": "--check"},
            "retainedResources": {
              "const": [
                "persistent-volume-claims",
                "shared-authentication-secret",
                "operator-public-trust",
                "namespace"
              ]
            },
            "removedResources": {
              "const": [
                "helm-release",
                "installer-receipt",
                "installer-smoke-resources"
              ]
            }
          }
        }
      }
    },
    "outOfScope": {
      "const": [
        "cluster-provisioning",
        "node-configuration",
        "container-runtime-installation",
        "firewall-configuration",
        "storage-provisioner-installation",
        "cloud-infrastructure",
        "operator-key-rotation-after-bootstrap"
      ]
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "default", "values", "verification"],
      "properties": {
        "name": {"enum": ["operator", "evaluation", "custom"]},
        "default": {"type": "boolean"},
        "values": {
          "enum": [
            "examples/values-bundled.yaml+installer-operator-overlay",
            "examples/values-bundled.yaml",
            "operator-supplied"
          ]
        },
        "verification": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "workloads-ready",
              "exact-digest-images",
              "operator-admin-ready",
              "local-admin-credential",
              "passkey-admin-bootstrap-ready",
              "anonymous-demo-disabled",
              "tools-list",
              "ledger-chain-advanced"
            ]
          }
        }
      }
    }
  }
}
