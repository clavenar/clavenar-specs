    "explicitNonclaims": {
      "type": "array",
      "prefixItems": [
        {
          "const": "production-authorized-by-offer"
        },
        {
          "const": "free-first-subscription-year"
        },
        {
          "const": "six-month-free-program"
        },
        {
          "const": "lifetime-price-lock"
        },
        {
          "const": "automatic-renewal"
        },
        {
          "const": "automatic-agent-overage-billing"
        },
        {
          "const": "automatic-token-overage-billing"
