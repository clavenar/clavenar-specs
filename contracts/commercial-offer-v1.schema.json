        "approvalGroups": {
          "type": "array",
          "prefixItems": [
            {
              "const": "Founder"
            },
            {
              "const": "Product"
            },
            {
              "const": "Finance"
            },
            {
              "const": "Legal"
            },
            {
              "const": "GTM"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true
        }
      }
