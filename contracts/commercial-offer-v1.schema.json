        "websiteSurfaces": {
          "const": 3
        },
        "onboardingPlaybooks": {
          "const": 2
        },
        "privateInputAliases": {
          "const": 2
        },
        "approvalGroups": {
          "const": 5
        },
        "acceptedConversationOutcomes": {
          "const": 3
        },
        "explicitNonclaims": {
          "const": 8
        },
        "publicFinancialAmounts": {
          "const": 0
        }
      }
