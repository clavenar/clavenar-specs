{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://specs.clavenar.com/contracts/attack-release-v1.schema.json",
  "title": "Clavenar attack release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "contractVersion",
    "release",
    "proxyCategories",
    "directIdentityScenarioIds",
    "totals"
  ],
  "properties": {
    "contractId": {
      "const": "clavenar.attack-release/v1"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "release": {
      "const": "1.233.0"
    },
    "proxyCategories": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scenarioIds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "scenarioIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "directIdentityScenarioIds": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proxyCategories",
        "proxyScenarios",
        "directIdentityScenarios",
        "listedScenarios"
      ],
      "properties": {
        "proxyCategories": {
          "const": 12
        },
        "proxyScenarios": {
          "const": 86
        },
        "directIdentityScenarios": {
          "const": 7
        },
        "listedScenarios": {
          "const": 93
        }
      }
    }
  }
}
