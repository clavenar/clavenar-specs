{
  "contract": "clavenar.cluster-install/v1",
  "schemaVersion": 1,
  "release": "1.246.0",
  "scope": "existing-kubernetes-cluster",
  "bootstrap": {
    "url": "https://clavenar.ai/install.sh",
    "shell": "sh",
    "command": "curl -fsSL https://clavenar.ai/install.sh | sh"
  },
  "installer": {
    "version": "1.3.0",
    "url": "https://clavenar.ai/installers/clavenar-install-1.3.0.sh",
    "checksumUrl": "https://clavenar.ai/installers/clavenar-install-1.3.0.sh.sha256",
    "mirrorUrls": [
      "https://dev.clavenar.ai/installers/clavenar-install-1.3.0.sh"
    ],
    "checksumMirrorUrls": [
      "https://dev.clavenar.ai/installers/clavenar-install-1.3.0.sh.sha256"
    ],
    "sha256": "sha256:63dd3fd8ada62f75d7f2f995cef6ff2c3e1a8be6752ab187250cc899fa981e17",
    "shell": "bash"
  },
  "uninstallBootstrap": {
    "url": "https://clavenar.ai/uninstall.sh",
    "shell": "sh",
    "command": "curl -fsSL https://clavenar.ai/uninstall.sh | sh"
  },
  "uninstaller": {
    "version": "1.0.0",
    "url": "https://clavenar.ai/installers/clavenar-uninstall-1.0.0.sh",
    "checksumUrl": "https://clavenar.ai/installers/clavenar-uninstall-1.0.0.sh.sha256",
    "mirrorUrls": [
      "https://dev.clavenar.ai/installers/clavenar-uninstall-1.0.0.sh"
    ],
    "checksumMirrorUrls": [
      "https://dev.clavenar.ai/installers/clavenar-uninstall-1.0.0.sh.sha256"
    ],
    "sha256": "sha256:53988955e8af3a7fb74a7bf24c36877c9b27dae173379d8d12240b09f822b12d",
    "shell": "bash"
  },
  "clusterAccess": {
    "clients": ["kubectl", "k3s-kubectl"],
    "contextPolicy": "explicit-or-confirmed-current-context",
    "minimumKubernetesMinor": 30,
    "maximumKubernetesMinor": 36,
    "preflight": [
      "api-reachable",
      "context-confirmed",
      "version-supported",
      "nodes-ready",
      "default-storage-class",
      "permissions-complete",
      "release-collision-checked",
      "operator-public-trust",
      "render-valid",
      "exact-digest-images"
    ]
  },
  "helmInstall": {
    "repository": "clavenar-charts",
    "version": "0.37.0",
    "registry": "oci://ghcr.io/clavenar/charts/clavenar",
    "releaseUrl": "https://github.com/clavenar/clavenar-charts/releases/tag/v0.37.0",
    "checksumAsset": "clavenar-0.37.0.tgz.sha256",
    "valuesAsset": "clavenar-images-1.246.0.yaml",
    "valuesSha256": "sha256:c7055aab76d456cd7f4b7ffa6737a7a04938a888908c5235febcd3b1b2646a0f",
    "packagedValues": "examples/values-bundled.yaml",
    "defaultNamespace": "clavenar",
    "defaultRelease": "clavenar",
    "timeout": "10m",
    "wait": true,
    "waitForJobs": true
  },
  "consoleAccess": {
    "defaultMode": "operator-mtls",
    "anonymousDemoDefault": false,
    "demoOptInProfile": "evaluation",
    "operatorTrustSecretNameTemplate": "{release}-operator-public-trust",
    "operatorTrustSecretKeys": ["ca.crt", "operators.json"],
    "operatorTrustInputFlags": ["--operator-ca", "--operator-registry"],
    "missingTrustPolicy": "local-admin-bootstrap",
    "operatorBootstrapDirectoryFlag": "--operator-bootstrap-dir",
    "localBootstrapDefaultRoot": "$HOME/.clavenar/operator-bootstrap",
    "localBootstrapRole": "admin",
    "localBootstrapPrivateKeyProjection": false,
    "browserCredentialFormat": "PKCS#12",
    "requiredOperatorRole": "admin",
    "mutationOriginsDefault": ["https://localhost:8085"]
  },
  "profiles": [
    {
      "name": "operator",
      "default": true,
      "values": "examples/values-bundled.yaml+installer-operator-overlay",
      "verification": [
        "workloads-ready",
        "exact-digest-images",
        "operator-admin-ready",
        "local-admin-credential",
        "anonymous-demo-disabled",
        "tools-list",
        "ledger-chain-advanced"
      ]
    },
    {
      "name": "evaluation",
      "default": false,
      "values": "examples/values-bundled.yaml",
      "verification": [
        "workloads-ready",
        "exact-digest-images",
        "tools-list",
        "ledger-chain-advanced"
      ]
    },
    {
      "name": "custom",
      "default": false,
      "values": "operator-supplied",
      "verification": [
        "workloads-ready",
        "exact-digest-images",
        "anonymous-demo-disabled"
      ]
    }
  ],
  "lifecycle": {
    "states": ["absent", "current", "upgrade", "failed", "foreign"],
    "collisionPolicy": "fail-closed",
    "failurePolicy": "preserve-release-and-state",
    "adoptionPolicy": "explicit-exact-release-only",
    "receipt": {
      "kind": "ConfigMap",
      "nameTemplate": "{release}-cluster-install-receipt",
      "containsSecrets": false
    },
    "uninstall": {
      "defaultDataDisposition": "retain",
      "namespaceDisposition": "retain",
      "ownershipPolicy": "exact-release-or-explicit-adoption",
      "destructiveDataFlag": "--delete-data",
      "destructiveConfirmationFlag": "--confirm-data-deletion",
      "checkFlag": "--check",
      "retainedResources": [
        "persistent-volume-claims",
        "operator-public-trust",
        "namespace"
      ],
      "removedResources": [
        "helm-release",
        "installer-receipt",
        "installer-smoke-resources"
      ]
    }
  },
  "outOfScope": [
    "cluster-provisioning",
    "node-configuration",
    "container-runtime-installation",
    "firewall-configuration",
    "storage-provisioner-installation",
    "cloud-infrastructure",
    "operator-key-rotation-after-bootstrap"
  ]
}
